# .env.example
# Environment configuration for AI-Powered Behavioral Anomaly Detection

# --- Core API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Storage Settings ---
DB_PATH=data/profiles/store.db
# Redis is for T2 upgrade
REDIS_URL=redis://localhost:6379/0

# --- ML Pipeline & Paths ---
MODEL_ARTIFACTS_DIR=models/behavioral_profiling/artifacts/
DATA_DIR=data/
MIN_PROFILE_EVENTS=10

# --- Streaming Settings ---
STREAMING_COMPRESSION_FACTOR=10.0
STREAMING_QUEUE_SIZE=1000

# --- Secrets ---
# (None required for T1; placeholder for future external API keys)
SECRET_KEY=change_me_in_production
